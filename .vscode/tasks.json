{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "podman-socket",
      "type": "process",
      "command": "systemctl",
      "args": [
        "--user",
        "restart",
        "podman.socket"
      ],
      "problemMatcher": []
    },
    {
      "label": "podman-up",
      "type": "process",
      "command": "podman",
      "args": [
        "compose",
        "up",
        "-d"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "podman-socket"
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/API/ResearchPublications.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": "podman-up"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Tests/IntegrationTests/ResearchPublications.IntegrationTests.csproj",
        "--disable-build-servers",
        "--maxcpucount:1"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOCKER_HOST": "unix://${env:XDG_RUNTIME_DIR}/podman/podman.sock",
          "DOCKER_API_VERSION": "1.40",
          "TESTCONTAINERS_RYUK_DISABLED": "true"
        }
      },
      "problemMatcher": "$msCompile",
      "dependsOn": "podman-socket"
    }
  ]
}
