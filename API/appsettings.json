{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PdfStorage": {
    "Path": "../pdfs"
  },
  "SeedGeneratedCatalog": false,
  "SqlSettings": {
    "Server": "",
    "Port": 1433,
    "DbName": "",
    "UserId": "",
    "Password": ""
  },
  "TypesenseSettings": {
    "Host": "",
    "Port": 8108,
    "Protocol": "http",
    "ApiKey": ""
  },
  "SearchIndexSync": {
    "Enabled": true,
    "IntervalSeconds": 5
  },
  "Ocr": {
    "Enabled": true,
    "OllamaBaseUrl": "http://localhost:11435",
    "Model": "frob/unlimited-ocr:3b",
    "Prompt": "Transcribe the visible text as Markdown. Use # for headings and blank lines between paragraphs. Omit bounding boxes, coordinates, and region labels. Return only the transcription.",
    "Dpi": 200,
    "IntervalSeconds": 5,
    "RetrySeconds": 300
  }
}
